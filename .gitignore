#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config (kept local, same as the original app's .gitignore) -
# not strictly secret, but regenerate locally with `flutterfire configure`
# rather than committing.
android/app/google-services.json
lib/firebase_options.dart

# Server-side secrets (e.g. the Raspberry Pi push-notification backend's
# Firebase Admin service account key) must never be committed.
*serviceAccountKey.json
*.env
.env
